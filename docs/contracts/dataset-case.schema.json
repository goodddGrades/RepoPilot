      "maxLength": 128
    },
    "taskType": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "input": {
      "type": "object"
    },
    "expected": {},
    "metadata": {
      "type": [
        "object",
        "null"
      ]
    }
  }
}
