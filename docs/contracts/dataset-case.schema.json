{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repopilot.local/schemas/dataset-case.schema.json",
  "title": "dataset-case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "caseKey",
    "taskType",
    "input"
  ],
