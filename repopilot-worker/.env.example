# ---------------------------------------------------------------------------
# repopilot-worker 环境变量模板
#
# 使用方式（也可直接复用仓库根目录的 .env，二者字段一致）：
#   cp .env.example .env
#   pip install -r requirements-dev.txt
#   uvicorn app.main:app --reload
#
# 注意：本文件与仓库根目录 .env.example 中的 WORKER_* 字段保持一致。
# ---------------------------------------------------------------------------

# 服务标识
WORKER_ENVIRONMENT=dev
WORKER_LOG_LEVEL=INFO
# json | console
WORKER_LOG_FORMAT=json

# HTTP 监听
WORKER_HOST=0.0.0.0
WORKER_PORT=8000

# Java 后端地址（后续 Worker 回调进度与结果时使用，V1 仅登记配置）
WORKER_SERVER_BASE_URL=http://127.0.0.1:8080

# ---------------------------------------------------------------------------
# 能力声明（WORKER_CAPABILITIES 决定 Worker 能领什么任务）
#   RUN:MOCK                  Mock Runner（协议演练用，非真实 Agent）
#   RUN:CLI                   真实 Coding Agent（需要本机已安装并登录对应 CLI）
#   EVAL:<evaluatorKey>       评测算子，未实现的 key 会让启动直接失败
# 纯评测 Worker 只声明 EVAL:* 即可，此时没有 Runner 是合法配置。
# ---------------------------------------------------------------------------
WORKER_WORKER_ID=mock-worker-1
WORKER_CAPABILITIES=RUN:MOCK,EVAL:output.non_empty,EVAL:answer.exact_match,EVAL:trace.tool_error,EVAL:cost.budget
WORKER_MAX_TASKS=1
WORKER_HEARTBEAT_INTERVAL=15
WORKER_POLL_INTERVAL=1
# true=进程启动后自动轮询；演示与测试建议保持 false，用 /worker/run-once 显式触发
WORKER_AUTOSTART=false
# 优雅关闭时等待"正在执行的那一轮"结束的上限（秒）。
# 执行线程只在两轮之间检查停止标志，所以正在跑的 Run 不会被腰斩；
# 超时仍没结束就放弃，租约到期后由回收器接手。0 表示不等待。
WORKER_SHUTDOWN_TIMEOUT=30

# Mock Runner 预设：SUCCESS | BUSINESS_FAILURE | TECHNICAL_ERROR | TIMEOUT | RETRYABLE_ERROR
WORKER_MOCK_SCENARIO=SUCCESS
# 首次尝试注入可重试错误，用于验证"基础设施重试不增加 Run"
WORKER_MOCK_FAIL_FIRST_ATTEMPT=false
# true 时把 output 作为 Artifact 上传
WORKER_UPLOAD_ARTIFACT=false

# ---------------------------------------------------------------------------
# 真实 Runner（TASK-008）：需要本机已安装并完成登录的 Coding Agent CLI
# 声明 RUN:CLI 但 CLI 不存在时，Worker 启动即失败（而不是领到任务才报错）。
# ---------------------------------------------------------------------------
WORKER_RUNNER_CLI=claude
# 留空表示不额外限制；填写后作为 --allowedTools 传给 CLI
WORKER_RUNNER_CLI_ALLOWED_TOOLS=
WORKER_RUNNER_CLI_MAX_TURNS=8
# 每次 Attempt 的工作目录根；留空则用系统临时目录，每次 Attempt 独立且用后删除
WORKER_RUNNER_WORKDIR_ROOT=

# ---------------------------------------------------------------------------
# Judge（TASK-008）：与被测 Agent 分开配置，只影响 EVAL:judge.rubric
#   claude=真实模型调用（需要本机 CLI 已认证）；stub=确定性测试桩（CI 用）
# stub 的结果带 provider=stub，不会被当作真实模型判断。
# ---------------------------------------------------------------------------
WORKER_JUDGE_PROVIDER=claude
WORKER_JUDGE_CLI=claude
WORKER_JUDGE_TIMEOUT_SECONDS=90
WORKER_JUDGE_STUB_VERDICT=PASS
# ok | ratelimit | malformed | no-score —— 仅 stub 模式使用
WORKER_JUDGE_STUB_INJECT=ok

# 基础设施（V1 不建立连接，仅登记配置，供后续任务使用）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=13306
MYSQL_DATABASE=repopilot
MYSQL_USER=repopilot
MYSQL_PASSWORD=

RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=repopilot
RABBITMQ_PASSWORD=

# ---- RabbitMQ 消息消费（TASK-013）----
#
# 默认**关闭**：Worker 靠 HTTP 轮询也能完整工作，消息只是加速器。
# 默认打开会让"没配 RabbitMQ"的部署直接起不来，而那本来是个合法配置。
WORKER_RABBITMQ_ENABLED=false

# 队列名必须与后端 RabbitTopology 声明的一致。
# 不同的 Worker 实例应订阅不同队列（repopilot.run.ready /
# repopilot.evaluation.ready），靠 binding 分流而不是抢同一条消息。
WORKER_RABBITMQ_QUEUE=repopilot.run.ready
WORKER_RABBITMQ_VHOST=/
WORKER_RABBITMQ_PREFETCH=1
WORKER_RABBITMQ_HEARTBEAT=30

# Inbox 去重登记用的**逻辑消费者名**，不是 Worker 实例 ID。
#
# 用实例 ID 会让每个实例都把同一条事件当成新事件登记一次，去重形同虚设；
# 用固定名字才能保证"一条事件在一个逻辑消费者上只处理一次"。
# 执行 Worker 与评测 Worker 用不同名字（TASK-013：worker-run / worker-eval）。
WORKER_INBOX_CONSUMER_NAME=worker-run

# 真实 broker 的集成测试开关（tests/test_consumer_rabbit.py）。
# 未设置时这一类测试整体跳过，跳过会出现在报告里，不会伪装成"已验证"。
# WORKER_TEST_RABBIT_HOST=127.0.0.1
# WORKER_TEST_RABBIT_PORT=5672
# WORKER_TEST_RABBIT_USER=repopilot
# WORKER_TEST_RABBIT_PASSWORD=

MINIO_HOST=127.0.0.1
MINIO_API_PORT=9000
MINIO_ROOT_USER=repopilot
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=repopilot
