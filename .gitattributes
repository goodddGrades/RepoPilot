# 统一行尾：仓库内以 LF 存储，避免 Windows/Linux 混用导致脚本失效
* text=auto eol=lf

# Windows 批处理必须 CRLF
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Maven Wrapper 脚本必须保持 LF，否则 Linux/macOS 下无法执行
mvnw text eol=lf

# 二进制文件不做任何转换
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.woff binary
*.woff2 binary

# 锁文件与生成物：避免 diff 噪音
package-lock.json linguist-generated=true
