# ============================================================================
# RepoPilot 环境变量模板
# ----------------------------------------------------------------------------
# 使用方式：
#   1. 复制本文件为 .env（.env 已被 .gitignore 忽略，禁止提交）
#        cp .env.example .env
#   2. 按需修改端口与凭据。默认值仅用于本地开发。
#   3. Docker Compose 使用根目录 .env：
#        docker compose --env-file .env -f deploy/docker-compose.yml up -d
#
# 约定：
#   * 所有密码必须通过环境变量注入，仓库内不得出现真实凭据。
#   * 本文件中的默认值仅适用于本地开发环境，生产环境必须替换。
#   * 主机端口可通过变量覆盖，避免与本地已安装的 MySQL/Redis 冲突。
# ============================================================================

# ---------------------------------------------------------------------------
# Compose 项目
# ---------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=repopilot

# 可选：覆盖镜像地址（内网 registry 或镜像站）
# MYSQL_IMAGE=mysql:8.0.36
# RABBITMQ_IMAGE=rabbitmq:3.13.7-management
# MINIO_IMAGE=minio/minio:RELEASE.2025-04-22T22-12-26Z
# 可选：MinIO 健康检查命令。官方镜像含 mc 时不用设置；
# 精简镜像不含 mc 时改为 HTTP 探活（先确认镜像内有 curl/wget）。
# MINIO_HEALTHCHECK=mc ready local
# MINIO_HEALTHCHECK=curl -f http://127.0.0.1:9000/minio/health/live
# REDIS_IMAGE=redis:7.2.5-alpine

# ---------------------------------------------------------------------------
# MySQL 8
# ---------------------------------------------------------------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=13306
MYSQL_DATABASE=repopilot
MYSQL_USER=repopilot
MYSQL_PASSWORD=repopilot_dev_pwd
MYSQL_ROOT_PASSWORD=repopilot_root_dev_pwd
# 容器内端口，通常无需修改
MYSQL_INTERNAL_PORT=3306

# ---------------------------------------------------------------------------
# RabbitMQ
# ---------------------------------------------------------------------------
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=repopilot
RABBITMQ_PASSWORD=repopilot_dev_pwd
RABBITMQ_VHOST=/

# ---------------------------------------------------------------------------
# MinIO（对象存储：轨迹附件、日志、实验报告）
# ---------------------------------------------------------------------------
MINIO_HOST=127.0.0.1
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=repopilot
MINIO_ROOT_PASSWORD=repopilot_dev_pwd
# 平台后续使用的默认桶名，本阶段仅记录，不创建
MINIO_BUCKET=repopilot

# ---------------------------------------------------------------------------
# Redis（TASK-014 起承载**分布式限流**，不再是纯预留实例）
# ---------------------------------------------------------------------------
# 端口 16379 是 compose 的对外映射，刻意不是 6379——避免误连机器上别的 Redis。
REDIS_HOST=127.0.0.1
REDIS_PORT=16379
REDIS_PASSWORD=repopilot_dev_pwd
REDIS_DATABASE=0

# ---- 入口限流（Java 侧）----
# 总开关；关闭时不注册拦截器、也不做任何 Redis 调用。
REPOPILOT_RATE_LIMIT_ENABLED=true
# 命名空间与环境隔离段。多环境共用一台 Redis 时必须不同。
REPOPILOT_RATE_LIMIT_KEY_PREFIX=repopilot:ratelimit
REPOPILOT_RATE_LIMIT_ENV=dev
# 默认不信任 X-Forwarded-For：只有位于可信反向代理之后才可设为 true。
REPOPILOT_RATE_LIMIT_TRUST_FORWARDED_FOR=false
# 高成本写入（创建实验 / 启动实验 / 创建评测批次）：
# 容量=允许的突发次数，refill=每秒补充令牌数（0.5 ≈ 长期 30 次/分钟）。
REPOPILOT_RATE_LIMIT_API_WRITE_CAPACITY=30
REPOPILOT_RATE_LIMIT_API_WRITE_REFILL=0.5
# 批量入口（导入 / 样本批量导入 / 制品上传）：单次更重，额度更低。
REPOPILOT_RATE_LIMIT_API_BULK_CAPACITY=5
REPOPILOT_RATE_LIMIT_API_BULK_REFILL=0.05

# ---------------------------------------------------------------------------
# Java 服务 (repopilot-server)
# ---------------------------------------------------------------------------
SERVER_PORT=8080
SERVER_PROFILE=dev
# Worker 内部接口（/internal/v1）的 Bearer 凭证。留空则内部接口一律拒绝（fail closed）。
# 本机开发请自行生成一个随机串；Java 与 Python Worker 读取同一个变量名。
REPOPILOT_WORKER_TOKEN=
# 可选：允许的 workerId 列表（逗号分隔）；留空表示不限制（凭证仍然必须正确）
REPOPILOT_WORKER_IDS=
# 可选：覆盖 application-dev.yml 中的连接信息（默认已与上面的基础设施端口对齐）
# SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:13306/repopilot?useSSL=false&serverTimezone=UTC&characterEncoding=utf8
# SPRING_RABBITMQ_HOST=127.0.0.1
# SPRING_RABBITMQ_PORT=5672

# ---------------------------------------------------------------------------
# Python Worker (repopilot-worker)
# ---------------------------------------------------------------------------
WORKER_HOST=0.0.0.0
WORKER_PORT=8000
WORKER_LOG_LEVEL=INFO
WORKER_LOG_FORMAT=json
WORKER_ID=mock-worker-1
WORKER_CAPABILITIES=RUN:MOCK
# Mock Runner 预设：SUCCESS / BUSINESS_FAILURE / TECHNICAL_ERROR / TIMEOUT / RETRYABLE_ERROR
WORKER_MOCK_SCENARIO=SUCCESS
# 首次尝试失败一次再成功（验证基础设施重试不增加 Run）
WORKER_MOCK_FAIL_FIRST_ATTEMPT=false
